# Copy to .env  (NEVER commit .env)
# Everything here has a safe default - the MVP runs with no .env at all.

GEOIP_PROVIDER=ip-api          # ip-api | geolite2 | mock
GEOIP_TIMEOUT_SECONDS=4
GEOIP_CACHE_TTL_SECONDS=3600
GEOLITE2_DB_PATH=backend/app/data/GeoLite2-City.mmdb

REPORT_OUTPUT_DIR=evidence
CUSTODY_LOG_PATH=evidence/custody_log.jsonl

MAX_UPLOAD_BYTES=2000000
ALLOW_ORIGINS=*
DEMO_MODE=false                # true => /analyze returns the frozen fixture
